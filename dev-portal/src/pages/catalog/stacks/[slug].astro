---
import Layout from '../../../layouts/Layout.astro';
import Hero from '../../../components/home/Hero.astro';
import SiteFooter from '../../../components/home/SiteFooter.astro';
import { findStack } from '../../../lib/stacks';

/*
 * The page for one stack.
 *
 * Structure is fixed on purpose: the same four concerns in the same order on
 * every stack — contract, tests, patterns, delivery — so a reader who knows one
 * page knows where to look on the next, and so a difference between two stacks
 * is visible as a difference rather than as a different page.
 *
 * The "Where it stands" block is not decoration. Every stack is an outline
 * today; saying so on the page is the difference between a scaffold and a claim.
 */
const { slug } = Astro.params;
const stack = slug ? findStack(slug) : undefined;

if (!stack) {
	return new Response(null, { status: 404, statusText: 'Not found' });
}
---

<Layout
	title={`${stack.title} — stacks — Dev Hub`}
	description={`${stack.title}: ${stack.question}`}
>
	<main id="main">
		<Hero
			kicker={stack.kicker}
			title={stack.title}
			lead={stack.question}
			parent={{ label: 'Stacks', href: '/catalog/stacks' }}
			actions={[
				{ label: 'Back to the stacks', href: '/catalog/stacks' },
				{ label: 'The practices behind them', href: '/doc/practices/' },
			]}
		/>

		<section aria-labelledby="covers-title" class="mx-auto w-full max-w-5xl px-6 py-16 sm:py-20">
			<p class="text-lg text-balance text-ink-muted sm:text-xl dark:text-slate-400">
				{stack.description}
			</p>

			<h2 id="covers-title" class="mt-12 text-2xl font-bold tracking-tight sm:text-3xl">
				The four concerns, in this stack's terms
			</h2>
			<ul class="mt-6 grid gap-6 sm:grid-cols-2">
				{
					stack.covers.map((concern) => (
						<li class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm dark:border-slate-700 dark:bg-night-raised">
							<h3 class="text-xl font-semibold">{concern.title}</h3>
							<p class="mt-3 text-ink-muted dark:text-slate-400">{concern.body}</p>
						</li>
					))
				}
			</ul>

			<!--
				The rows are in the same order on every stack, so the six pages can be
				read as one comparison. The reasoning behind each choice is in
				/doc/testing-tools/ — this is the answer, not the argument.
			-->
			<h2 id="tools-title" class="mt-14 text-2xl font-bold tracking-tight sm:text-3xl">
				Testing tools
			</h2>
			<div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-700">
				<table class="w-full border-collapse text-left">
					<thead class="bg-slate-50 dark:bg-night-raised">
						<tr>
							<th scope="col" class="px-5 py-3 text-xs font-semibold tracking-[0.14em] text-ink-muted uppercase dark:text-slate-400">
								Job
							</th>
							<th scope="col" class="px-5 py-3 text-xs font-semibold tracking-[0.14em] text-ink-muted uppercase dark:text-slate-400">
								What to use
							</th>
						</tr>
					</thead>
					<tbody>
						{
							stack.tools.map((tool) => (
								<tr class="border-t border-slate-200 dark:border-slate-700">
									<th scope="row" class="px-5 py-3 font-normal text-ink-muted dark:text-slate-400">
										{tool.role}
									</th>
									<td class="px-5 py-3 font-semibold">{tool.name}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
			<p class="mt-4 text-sm text-ink-muted dark:text-slate-400">
				Why each one, and what it costs:&nbsp;<a
					class="font-semibold text-brand dark:text-sky-400"
					href="/doc/testing-tools/">Testing tools<span aria-hidden="true">&nbsp;→</span></a
				>
			</p>

			<h2 class="mt-14 text-2xl font-bold tracking-tight sm:text-3xl">Where it stands</h2>
			<dl class="mt-6 grid gap-4 sm:grid-cols-2">
				<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-night-raised">
					<dt class="text-sm font-semibold tracking-wide text-ink-muted uppercase dark:text-slate-400">
						Status
					</dt>
					<dd class="mt-1 text-lg font-semibold">Outline</dd>
				</div>
				<div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-night-raised">
					<dt class="text-sm font-semibold tracking-wide text-ink-muted uppercase dark:text-slate-400">
						Starter project
					</dt>
					<dd class="mt-1 text-lg font-semibold">{stack.blueprint?.label ?? 'Not yet assigned'}</dd>
					{
						stack.blueprint && (
							<dd class="mt-2 text-sm text-ink-muted dark:text-slate-400">{stack.blueprint.note}</dd>
						)
					}
				</div>
			</dl>

			<p class="mt-6 max-w-3xl text-ink-muted dark:text-slate-400">{stack.state}</p>

			<p class="mt-10 text-ink-muted dark:text-slate-400">
				A stack page earns its detail from a project that actually ran this way. Until then
				it states the intent and admits the gap.
				&nbsp;<a class="font-semibold text-brand dark:text-sky-400" href="/catalog/stacks">
					Back to the stacks<span aria-hidden="true">&nbsp;→</span>
				</a>
			</p>
		</section>
	</main>
	<SiteFooter />
</Layout>
