---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import SectionPanels, { type Panel } from '../components/home/SectionPanels.astro';
import Testimonials from '../components/home/Testimonials.astro';
import SiteFooter from '../components/home/SiteFooter.astro';

/*
 * The four areas of the hub.
 *
 * Documentation and Catalog are `live` — the pages behind them exist and are
 * worth opening. MCP is `soon`: the documentation section describing the five
 * servers is real, the servers are not. Academy is `soon` for the same reason —
 * the curriculum is settled and the lessons are not written.
 *
 * The home page should not promise anything that is not behind the link.
 */
const areas: readonly Panel[] = [
	{
		title: 'Documentation',
		description:
			'What effective software development is, and how it is done here: the four attitudes, the connecting practices, the pattern vocabulary, and where the machine takes over.',
		href: '/doc/',
		cta: 'Read the documentation',
		status: 'live',
		icon: 'M5 4h9l5 5v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm8 0v6h6M8 14h8M8 17.5h5',
	},
	{
		title: 'Catalog',
		description:
			'Seven catalogues of things to look up rather than read through — APIs, C4 models, events, components, practices, code design and technology stacks.',
		href: '/catalog',
		cta: 'Browse the catalogs',
		status: 'live',
		icon: 'M4 5.5A1.5 1.5 0 0 1 5.5 4H10v16H5.5A1.5 1.5 0 0 1 4 18.5v-13ZM10 4h8.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H10M13 8.5h4M13 12h4',
	},
	{
		title: 'MCP',
		description:
			'The half of the work a model can do: scaffolding code from patterns, generating and retro-engineering LikeC4 models, and drafting an API design for a human to decide on.',
		href: '/doc/mcp/',
		cta: 'See what is automated',
		status: 'soon',
		icon: 'M12 3v4m0 10v4M3 12h4m10 0h4M7.5 7.5l2.8 2.8m3.4 3.4 2.8 2.8m0-9-2.8 2.8m-3.4 3.4-2.8 2.8',
	},
	{
		title: 'Academy',
		description:
			'Seven learning paths, from the rituals that connect specialists through test-first and contract-first design to where AI actually helps.',
		href: '/academy',
		cta: 'See the curriculum',
		// `soon`, not `planned`: the page exists and the curriculum on it is worth
		// reading; it is the lessons behind it that are not written yet.
		status: 'soon',
		icon: 'M12 4 22 9l-10 5L2 9l10-5Z M6 11.5v4.7c0 .8.5 1.4 1.2 1.8 1.3.7 2.9 1.1 4.8 1.1s3.5-.4 4.8-1.1c.7-.4 1.2-1 1.2-1.8v-4.7 M22 9v5.5',
	},
] as const;
---

<Layout
	title="Dev Hub — effective software development"
	description="Effective software development is connected, contract-first, semi-automated and agile. Four attitudes — UX-first, test-first, contract-first, API-first — patterns-oriented design, and AI as a booster for a practice that was already sound."
>
	<main id="main">
		<Hero
			kicker="Effective software development"
			title="Connected, contract-first, semi-automated, agile."
			lead="Effective software development embodies a UX-first, a test-first, a contract-first and an API-first attitude, and a
				patterns-oriented design. It runs on techniques and rituals that connect the
				specialists — end-users, UX designers, domain experts, developers, architects,
				quality engineers, product owners, operations — rather than sequencing them. AI
				comes last, as a booster and an enabler of automation, because it multiplies
				whatever discipline it finds. This hub is where that work takes place."
			actions={[
				{ label: 'Read the documentation', href: '/doc/' },
				{ label: 'Browse the catalogs', href: '/catalog' },
			]}
		/>
		<Testimonials />
		<SectionPanels panels={areas} label="Areas" columns={4} />
	</main>
	<SiteFooter />
</Layout>
